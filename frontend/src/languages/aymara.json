  "normalizador": {
    "nota": "Reglas del aymara central: tres vocales, alternancia q/k, glotalizadas y aspiradas, j/x/h y grafías castellanas.",
    "reglas": [
      { "patron": "chh", "reemplazo": "ch", "fenomeno": "aspirada" },
