      { "patron": "(ch|[ptkq])'", "reemplazo": "$1", "fenomeno": "glotalizada" },
      { "patron": "hu(?=[aeiou])", "reemplazo": "w", "fenomeno": "grafia" },
      { "patron": "qu(?=[ei])", "reemplazo": "k", "fenomeno": "grafia" },
      { "patron": "c(?=[aou])", "reemplazo": "k", "fenomeno": "grafia" },
      { "patron": "[xh]", "reemplazo": "j", "fenomeno": "grafia" },
      { "patron": "e", "reemplazo": "i", "fenomeno": "vocal" },
      { "patron": "o", "reemplazo": "u", "fenomeno": "vocal" },
      { "patron": "q", "reemplazo": "k", "fenomeno": "uvular" }
