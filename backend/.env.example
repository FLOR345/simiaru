# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env a GitHub.

# ===== Servidor =====
# BACKEND_URL es opcional en Render (se detecta solo)
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ===== Base de datos (Neon / PostgreSQL) — OBLIGATORIO =====
# Ejemplo: postgresql://usuario:contraseña@host/neondb?sslmode=require
DATABASE_URL=
# Neon exige SSL. Para una base local o de Docker sin SSL: DATABASE_SSL=false
# DATABASE_SSL=false

# ===== Seguridad — OBLIGATORIO =====
# Genera valores largos y aleatorios, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=

# ===== Investigación y administración =====
# Correos (separados por comas) de quienes pueden exportar todos los eventos de investigación
ADMIN_EMAILS=
# Sal para los seudónimos de la exportación (si falta se usa JWT_SECRET). No la cambies después de empezar a recolectar.
RESEARCH_SALT=

# ===== Login con Google (opcional: sin estas claves, el botón avisa que no está configurado) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Login con Facebook (opcional) =====
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ===== Imágenes (Cloudinary) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Correos (Brevo) =====
BREVO_API_KEY=

