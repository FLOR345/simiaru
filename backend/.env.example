# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env a GitHub.

# ===== Servidor =====
# BACKEND_URL es opcional en Render (se detecta solo)
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ===== Base de datos (Neon / PostgreSQL) — OBLIGATORIO =====
# Ejemplo: postgresql://usuario:contraseña@host/neondb?sslmode=require
DATABASE_URL=

# ===== Seguridad — OBLIGATORIO =====
# Genera valores largos y aleatorios, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=

# ===== Login con Google =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Login con Facebook =====
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ===== Imágenes (Cloudinary) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Correos (Brevo) =====
BREVO_API_KEY=

# ===== Solo para los scripts locales (insertar-seeds.js, etc.) =====
DB_PASSWORD=
